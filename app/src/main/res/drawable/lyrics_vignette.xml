<?xml version="1.0" encoding="utf-8"?>
<!-- A faint dark edge on the left and right of the lyrics, so the text looks like it floats. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="0"
                android:centerColor="#00000000"
                android:centerX="0.14"
                android:endColor="#00000000"
                android:startColor="#66000000" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="180"
                android:centerColor="#00000000"
                android:centerX="0.14"
                android:endColor="#00000000"
                android:startColor="#66000000" />
        </shape>
    </item>
</layer-list>
