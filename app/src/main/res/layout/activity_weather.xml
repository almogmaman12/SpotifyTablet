<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/weather_bg_gradient"
    tools:context=".WeatherActivity">

    <!-- Gradient overlay for depth -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_overlay" />

    <!-- Full-screen vertical layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- TOP: Horizontal split (temp left, stats right) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- LEFT SIDE: Main temperature -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:id="@+id/imgWeatherIconLarge"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/txtTemperature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-thin"
                    android:includeFontPadding="false"
                    android:textColor="#FFFFFF"
                    android:textSize="130sp"
                    tools:text="31°" />

                <TextView
                    android:id="@+id/txtCondition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="0.15"
                    android:textAllCaps="true"
                    android:textColor="#B0FFFFFF"
                    android:textSize="18sp"
                    tools:text="SUNNY" />

                <TextView
                    android:id="@+id/txtLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-light"
                    android:textColor="#80FFFFFF"
                    android:textSize="14sp"
                    tools:text="Jerusalem, Israel" />
            </LinearLayout>

            <!-- RIGHT SIDE: Stats 2x2 grid -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="24dp"
                android:paddingTop="32dp"
                android:paddingBottom="16dp">

                <!-- Top row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/glass_card"
                        android:gravity="center"
                        android:layout_margin="6dp"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.1"
                            android:text="מרגיש כמו"
                            android:textColor="#80FFFFFF"
                            android:textSize="10sp" />
                        <TextView
                            android:id="@+id/txtFeelsLike"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="sans-serif-light"
                            android:textColor="#FFFFFF"
                            android:textSize="28sp"
                            tools:text="29°" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/glass_card"
                        android:gravity="center"
                        android:layout_margin="6dp"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.1"
                            android:text="לחות"
                            android:textColor="#80FFFFFF"
                            android:textSize="10sp" />
                        <TextView
                            android:id="@+id/txtHumidity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="sans-serif-light"
                            android:textColor="#FFFFFF"
                            android:textSize="28sp"
                            tools:text="16%" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Bottom row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/glass_card"
                        android:gravity="center"
                        android:layout_margin="6dp"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.1"
                            android:text="רוח"
                            android:textColor="#80FFFFFF"
                            android:textSize="10sp" />
                        <TextView
                            android:id="@+id/txtWind"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="sans-serif-light"
                            android:textColor="#FFFFFF"
                            android:textSize="28sp"
                            tools:text="22 km/h" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/glass_card"
                        android:gravity="center"
                        android:layout_margin="6dp"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.1"
                            android:text="אינדקס UV"
                            android:textColor="#80FFFFFF"
                            android:textSize="10sp" />
                        <TextView
                            android:id="@+id/txtUV"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="sans-serif-light"
                            android:textColor="#FFFFFF"
                            android:textSize="28sp"
                            tools:text="Low" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        

<!-- BOTTOM: Hourly forecast -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.12"
                android:text="תחזית שעה"
                android:textColor="#60FFFFFF"
                android:textSize="10sp" />

            <HorizontalScrollView
                android:id="@+id/hourlyScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:paddingHorizontal="32dp"
                android:scrollbars="none">

                <!-- The gravity="center" here combined with fillViewport fixes the centering -->
                <LinearLayout
                    android:id="@+id/hourlyContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>
    </LinearLayout>

    <!-- Close button -->
    <ImageView
        android:id="@+id/btnExitWeather"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:padding="8dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:alpha="0.4"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="סגור" />
    <!-- Next Days button -->
    <ImageButton
        android:id="@+id/btnNextDays"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="16dp"
        android:src="@android:drawable/ic_media_next"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:tint="#FFFFFF"
        android:contentDescription="ימים הבאים" />

</FrameLayout>