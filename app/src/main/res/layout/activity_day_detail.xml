<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/weather_bg_gradient"
    tools:context=".DayDetailActivity">

    <!-- Gradient overlay for depth -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_overlay" />

    <!-- Full-screen vertical layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Horizontal split (temp left, stats right) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- LEFT SIDE: Main temperature and Date -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:id="@+id/dayDetailIcon"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/dayDetailTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-thin"
                    android:includeFontPadding="false"
                    android:textColor="#FFFFFF"
                    android:textSize="90sp"
                    tools:text="31°" />

                <TextView
                    android:id="@+id/dayDetailCondition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="0.15"
                    android:textAllCaps="true"
                    android:textColor="#B0FFFFFF"
                    android:textSize="18sp"
                    tools:text="SUNNY" />

                <TextView
                    android:id="@+id/dayDetailDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-light"
                    android:textColor="#80FFFFFF"
                    android:textSize="20sp"
                    android:text="יום שני" />
            </LinearLayout>

            <!-- RIGHT SIDE: Stats 2x2 grid -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="24dp">

                <!-- Top row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/glass_card"
                        android:gravity="center"
                        android:layout_margin="6dp"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.1"
                            android:text="נמוך / גבוה"
                            android:textColor="#80FFFFFF"
                            android:textSize="10sp" />
                        <TextView
                            android:id="@+id/dayDetailHighLow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="sans-serif-light"
                            android:textColor="#FFFFFF"
                            android:textSize="24sp"
                            tools:text="31° / 20°" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/glass_card"
                        android:gravity="center"
                        android:layout_margin="6dp"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.1"
                            android:text="לחות"
                            android:textColor="#80FFFFFF"
                            android:textSize="10sp" />
                        <TextView
                            android:id="@+id/dayDetailHumidity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="sans-serif-light"
                            android:textColor="#FFFFFF"
                            android:textSize="24sp"
                            tools:text="16%" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Bottom row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/glass_card"
                        android:gravity="center"
                        android:layout_margin="6dp"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.1"
                            android:text="רוח"
                            android:textColor="#80FFFFFF"
                            android:textSize="10sp" />
                        <TextView
                            android:id="@+id/dayDetailWind"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="sans-serif-light"
                            android:textColor="#FFFFFF"
                            android:textSize="24sp"
                            tools:text='22 קמ"ש' />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/glass_card"
                        android:gravity="center"
                        android:layout_margin="6dp"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.1"
                            android:text="אינדקס UV"
                            android:textColor="#80FFFFFF"
                            android:textSize="10sp" />
                        <TextView
                            android:id="@+id/dayDetailUV"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="sans-serif-light"
                            android:textColor="#FFFFFF"
                            android:textSize="24sp"
                            tools:text="נמוך" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Close button -->
    <ImageView
        android:id="@+id/btnCloseDayDetail"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:padding="8dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:alpha="0.4"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="סגור" />

</FrameLayout>
