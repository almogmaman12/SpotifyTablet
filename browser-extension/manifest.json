{
  "manifest_version": 3,
  "name": "Tablet Now Playing",
  "version": "1.2.0",
  "description": "Sends what is playing in this browser (Netflix, YouTube, YouTube Music, SoundCloud, any video or audio page) to your Spotify Tablet app over your local network, and lets the tablet pause, skip and seek.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content-main.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "lib.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Tablet Now Playing",
    "default_popup": "options.html"
  },
  "minimum_chrome_version": "111"
}
